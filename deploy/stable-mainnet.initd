#!/sbin/openrc-run
# bitcoin.dance behind nginx: plain HTTP on :3000, no ACME (nginx holds the certs now).

name="stable-mainnet"
description="bitcoin.dance passkey wallet (HTTP :3000, behind nginx)"

supervisor="supervise-daemon"
command="/usr/local/bin/bun"
command_args="server/index.js"
directory="/var/www/mainnet.bitcoin.dance"
output_log="/var/log/stable-mainnet.log"
error_log="/var/log/stable-mainnet.log"
pidfile="/var/run/stable-mainnet.pid"

respawn_delay=5
respawn_max=0

start_pre() {
    export PORT=3000
    export DOMAINS=""
    # TEMPORARY (2026-10-13): the startup history scan from the real BANK_BLOCK
    # in .env covers 1.4M Base blocks through an RPC that answers "request
    # limit reached", which keeps the site down for hours. Scanning from near
    # the head brings it up in a minute; the activity list only shows events
    # from here on. Remove this line and restart once the RPC quota is fixed.
    export BANK_BLOCK=52553000
}

depend() {
    need net
}
